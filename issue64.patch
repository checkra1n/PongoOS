+    uint32_t  vmaddr;
+    uint32_t  vmsize;
+    uint32_t  fileoff;
+    uint32_t  filesize;
+    vm_prot_t maxprot;
+    vm_prot_t initprot;
+    uint32_t  nsects;
+    uint32_t  flags;
+} mach_seg32_t;
+
+typedef struct
+{
+    uint32_t  cmd;
+    uint32_t  cmdsize;
+    char      segname[16];
+    uint64_t  vmaddr;
+    uint64_t  vmsize;
+    uint64_t  fileoff;
+    uint64_t  filesize;
+    vm_prot_t maxprot;
+    vm_prot_t initprot;
+    uint32_t  nsects;
+    uint32_t  flags;
+} mach_seg64_t;
+
+typedef struct
+{
+    char sectname[16];
+    char segname[16];
+    uint32_t addr;
+    uint32_t size;
+    uint32_t offset;
+    uint32_t align;
+    uint32_t reloff;
+    uint32_t nreloc;
+    uint32_t flags;
