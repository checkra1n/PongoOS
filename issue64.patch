+#define derDecDbg(a)			iprintf(a)
+#define derDecDbg1(a, b)		iprintf(a, b)
+#define derDecDbg2(a, b, c)		iprintf(a, b, c)
+#define derDecDbg3(a, b, c, d)	iprintf(a, b, c, d)
+#else	
