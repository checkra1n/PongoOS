+        0xf8418c00, // ldr x*, [x*, 0x18]!
+        0xb5000000, // cbnz x*, 0x...
+        0xaa090000, // mov x*, x*
+        0xb9400c00, // ldr w0, [x*, 0xc]
+    };
+    uint64_t masks2[] = {
+        0xfffffc00,
+        0xff000000,
+        0xfffffc00,
+        0xfffffc1f,
+    };
