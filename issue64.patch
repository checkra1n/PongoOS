-/*
- * Feature test macros control which symbols are exposed by the system
- * headers.  Any of these must be defined before including any headers.
- *
- * __STRICT_ANSI__ (defined by gcc -ansi, -std=c90, -std=c99, or -std=c11)
- *	ISO C
