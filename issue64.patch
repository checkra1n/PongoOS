+    struct task* task_list;
+    lock lock;
+};
+
+struct task { // a task is a thread-like execution environment, executing under a given process and vmspace
+    uint64_t x[30];
+    uint64_t lr;
+    uint64_t sp;
+    uint64_t runcnt;
+    uint64_t real_lr;
