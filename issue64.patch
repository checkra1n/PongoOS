-#define	tan(__x)		__tg_full(__x, tan)
-#define	cosh(__x)		__tg_full(__x, cosh)
-#define	sinh(__x)		__tg_full(__x, sinh)
-#define	tanh(__x)		__tg_full(__x, tanh)
