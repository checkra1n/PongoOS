+
+bool DEROidCompare(const DERItem *oid1, const DERItem *oid2) {
+	if ((oid1 == NULL) || (oid2 == NULL)) {
+		return false;
+	}
+	if (oid1->length != oid2->length) {
+		return false;
+	}
+	if (!DERMemcmp(oid1->data, oid2->data, oid1->length)) {
+		return true;
+	} else {
+		return false;
+	}
