+uint32_t* find_next_insn(uint32_t* from, uint32_t num, uint32_t insn, uint32_t mask)
+{
+    while(num)
+    {
+        if((*from & mask) == (insn & mask))
+        {
+            return from;
+        }
+        from++;
+        num--;
+    }
+    return NULL;
+}
+uint32_t* find_prev_insn(uint32_t* from, uint32_t num, uint32_t insn, uint32_t mask)
+{
+    while(num)
+    {
+        if((*from & mask) == (insn & mask))
+        {
+            return from;
+        }
+        from--;
+        num--;
+    }
+    return NULL;
+}
